# systemd unit：开机自启 docker compose
# 安装：cp deploy/systemd/tt-shop.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable tt-shop
# 作用：服务器重启后自动 docker compose up -d；docker 自身的 restart=always 已经能扛容器崩，
#      这层是兜底"宿主机重启"场景。

[Unit]
Description=TT Shop fulfillment system (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tt-shop

# 拉镜像（如果上游有更新；CI 推镜像后这里会自动拿；本地构建场景这步走 cache 很快）
ExecStartPre=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file .env.production pull --ignore-pull-failures

# 启动 / 停止 / 重载
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file .env.production up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file .env.production down
ExecReload=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file .env.production up -d --remove-orphans

TimeoutStartSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
