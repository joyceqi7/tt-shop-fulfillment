# ===========================================
# 生产环境变量模板（复制为 .env.production，scp 到服务器 /opt/tt-shop/）
# .env.production 不入 git；服务器上 chmod 600
#
# 生成强随机串：
#   openssl rand -base64 32
#   openssl rand -hex 32
# ===========================================

# --- 环境 ---
APP_ENV=prod
LOG_LEVEL=INFO

# --- TT Open API 凭证（生产 App，从 Partner Center 拿）---
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_REFRESH_TOKEN=
TTS_SELLER_ID=
TTS_API_BASE=https://open-api.tiktokglobalshop.com
TTS_AUTH_BASE=https://auth.tiktok-shops.com

# --- OAuth 授权（让店主点一次授权）---
TTS_SERVICE_ID=              # !! 必填，Partner Center App 详情页的 App ID
TTS_AUTHORIZE_BASE=https://services.tiktokshop.com   # Cross-border / 全球卖家；US Local 卖家改成 https://services.us.tiktokshop.com
TTS_OAUTH_REDIRECT_URL=https://tts-api.sailson.com/oauth/tts/callback
OAUTH_STATE_TTL_SECONDS=600

# --- 代理：生产服务器（阿里云美东 ECS）裸直连 TT，留空 ---
# !!! 严禁在境外服务器上配代理（违反风险表第 17 条的反向约定）!!!
TTS_HTTP_PROXY=

# --- DB（容器内 hostname 是服务名 postgres，5432 走容器内网）---
POSTGRES_DB=tts
POSTGRES_USER=tts
POSTGRES_PASSWORD=          # !! 必填，openssl rand -base64 24
DATABASE_URL=postgresql+asyncpg://tts:CHANGE_ME@postgres:5432/tts

# --- Redis（容器内 hostname 是服务名 redis）---
REDIS_URL=redis://redis:6379/0

# --- Fernet 主密钥 ---
# !! 生产用一个独立的密钥，绝不和 dev/staging 共用
# !! 一旦泄漏：rotate 流程见 deploy/README.md "密钥轮换"章节
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Sentry ---
# 生产强烈建议接，免费档够用（5k events/月）
SENTRY_DSN=

# --- 飞书告警 ---
# 群机器人 webhook，去飞书群"设置 → 群机器人 → 添加 → 自定义机器人"拿
FEISHU_WEBHOOK_URL=

# --- 业务参数 ---
CODE_LOCK_TIMEOUT_SECONDS=600
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_WINDOW_HOURS=24
TTS_API_QPS=10                  # !! Week 0 问完直客后改成真值
TOKEN_REFRESH_BUFFER_SECONDS=600
TT_PLATFORM_COMMISSION_RATE=0.06   # 调价预警：扣税净价 = 售价 × (1 - 此比例)
STALE_SHIPMENT_ALERT_SECONDS=14400  # 未发货超时告警（默认 4 小时）

# --- 监控告警阈值（watchdog_task 用，按业务现况微调）---
STOCK_ALERT_THRESHOLD=50        # 卡密水位低于这个 → 飞书告警
TOKEN_EXPIRE_ALERT_SECONDS=21600 # access_token 剩余 < 6h → 告警
RECONCILIATION_LAG_ALERT_SECONDS=7200  # 对账滞后 > 2h → 告警

# --- 管理 API ---
# !! 生产必填，强随机串：openssl rand -base64 32
ADMIN_TOKEN=

# --- 后台管理控制台（admin console）---
# 首次启用用户管理时自动创建的管理员用户名（自定义，建议非 admin/root 之类弱字典词）
ADMIN_USERNAME=
# 首次管理员密码的 bcrypt 哈希；用 scripts/gen_admin_hash.py 生成（不要直接写明文）
ADMIN_PASSWORD_HASH=
# 会话签名密钥，强随机串：openssl rand -base64 48
ADMIN_SESSION_SECRET=
# 会话有效期（秒），默认 8 小时
ADMIN_SESSION_TTL_SECONDS=28800
# 登录失败计数 & 限流阈值（保留默认即可）
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# --- Webhook 验签 ---
# 生产严禁打开（true）；联调期对方调试时可临时 true，调完立刻 false
WEBHOOK_VERIFY_DISABLED=false

# --- Caddy / TLS ---
# Let's Encrypt 注册邮箱（用公司域名邮箱，证书快过期会发提醒）
ACME_EMAIL=user1@example.com

# --- 备份 ---
# 阿里云 OSS（建议用美西/新加坡 Bucket 跨地域同步到国内冷备 Bucket）
OSS_ENDPOINT=oss-us-west-1.aliyuncs.com
OSS_BUCKET=sailson-shop-backup
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 备份加密密码（独立于 FERNET_KEY，运维持有）
BACKUP_ENCRYPTION_PASSPHRASE=


# --- 内容创作 / 视频工作流 ---
# Admin 容器内访问 workflow-api 的地址；通常保持默认即可
WORKFLOW_API_BASE_URL=http://workflow-api:8001
WORKFLOW_MAX_CONCURRENT_JOBS=1

# LLM: 推荐 DeepSeek 写英文脚本 + 千问 VL 做视觉识别
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_TEXT_MODEL=deepseek-chat

VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
LLM_VISION_MODEL=qwen-vl-max

# TTS: elevenlabs / openai / none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# 封面：默认通义万相；DeepSeek 没有文生图
IMAGE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn
IMAGE_MODEL=wan2.6-t2i
IMAGE_SIZE=1080*1920
COVER_IMAGE_ENABLED=true

# 下载 cookies
# - YouTube 正式素材抓取建议配置：导出 Netscape cookies.txt 到 /data/workflow/cookies/youtube.txt
# - 配好后填绝对路径并重启 workflow-api
# - 抖音/TikTok 如后续需要登录态，也按同样方式挂到 /data/workflow/cookies/
DOUYIN_COOKIES_FILE=
YOUTUBE_COOKIES_FILE=

# ASR / 视觉抽帧
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_LANGUAGE=zh
FRAME_SAMPLE_INTERVAL=2.0
