# ===========================================
# TT Shop 履约系统环境变量示例
# 复制为 .env 并填入真实值；.env 不要提交 git
# ===========================================

# --- 环境 ---
APP_ENV=dev               # dev / staging / prod
LOG_LEVEL=INFO

# --- TT Open API 凭证（测试账号在 docs/ 下的 docx 里） ---
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_REFRESH_TOKEN=
TTS_SELLER_ID=
# 业务 API 域名（getOrderList / redeemInfoCallback 等都走这个）
TTS_API_BASE=https://open-api.tiktokglobalshop.com
# 授权服务独立域名（refresh token / auth code 换 token 走这个）
TTS_AUTH_BASE=https://auth.tiktok-shops.com

# --- OAuth 授权（店主点一次授权建立 App ↔ Shop 绑定；dev 期可不填，靠 TTS_REFRESH_TOKEN 直接刷）---
# Partner Center App 详情页的 App ID / Service ID
TTS_SERVICE_ID=
# 授权入口 base URL（美区；其它区域按 TT 文档替换）
TTS_AUTHORIZE_BASE=https://services.us.tiktokshop.com
# 回调完整 URL，填进 Partner Center 的 Redirect URL 字段；dev 留空即可
TTS_OAUTH_REDIRECT_URL=
# state TTL 秒数（10min，店主授权超时保护）
OAUTH_STATE_TTL_SECONDS=600

# --- 代理（仅开发机国内环境需要；生产服务器买美东/新加坡主机直连，此处留空） ---
# 示例：TTS_HTTP_PROXY=http://127.0.0.1:7890
# 打开你的 Clash/Surge/V2rayN 等工具，查看 HTTP 代理端口后填入
TTS_HTTP_PROXY=

# --- Webhook 验签 ---
# TT webhook header 里会带 sign，用 app_secret 校验
# 此处不需要单独配置，沿用 TTS_APP_SECRET

# --- DB ---
DATABASE_URL=postgresql+asyncpg://tts:tts@localhost:5432/tts

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 加密主密钥（Fernet，32 字节 urlsafe base64）---
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- 告警 ---
FEISHU_WEBHOOK_URL=

# --- 业务参数 ---
# 卡密锁定后未使用的自动解锁阈值（秒）
CODE_LOCK_TIMEOUT_SECONDS=600
# 对账 Job 轮询间隔（秒）
RECONCILE_INTERVAL_SECONDS=300
# 对账 Job 拉取的时间窗口（小时）
RECONCILE_WINDOW_HOURS=24
# TT API 全局 QPS 上限（Week 0 问直客后填）
TTS_API_QPS=10
# 距离 access_token 过期还剩多少秒时主动刷新（提前量）
TOKEN_REFRESH_BUFFER_SECONDS=600

# --- 管理 API ---
# 联调/应急用的 /admin/* 接口鉴权 token。未设置则整组路由 503 禁用。
# 生产务必设置强随机串（32+ 字符）
ADMIN_TOKEN=

# 联调期设为 true 可跳过 webhook 验签（只在 dev 可用）
WEBHOOK_VERIFY_DISABLED=false
